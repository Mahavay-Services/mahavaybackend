# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=startup_support_crm
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration — generate strong random secrets for production
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_64_char_random_string
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./storage

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
